# El archivo .env contiene credenciales sensibles y NO debe versionarse.
# Usar .env.example como plantilla.

# ==== Laravel / Composer ====
/vendor/
node_modules/
npm-debug.log*
yarn-debug.log*
yarn-error.log*

# ==== Variables de entorno con credenciales ====
.env
.env.backup
.env.production
.env.local
.env.staging

# ==== Runtime de Laravel ====
# Cada directorio storage/* contiene su propio .gitignore para conservar la
# estructura requerida sin versionar sesiones, caché, vistas ni logs.

# ==== Claves / certificados ====
*.key
*.pem
*.crt

# ==== Sistema operativo / IDE ====
.DS_Store
Thumbs.db
.idea/
.vscode/
*.code-workspace
.phpunit.result.cache
.phpunit.cache
.homestead.yaml
Homestead.json
Homestead.yaml
auth.json

# ==== Laravel Sail (opcional, no usado en producción) ====
docker-compose.yml
docker-compose.override.yml

# ==== Dependencias locales ====
# composer.lock SÍ se versiona en aplicaciones para despliegues reproducibles.
phpunit.xml
.review/
