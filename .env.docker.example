APP_NAME="ERP BMS Local"
APP_ENV=local
APP_KEY=base64:AAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAA=
APP_DEBUG=true
APP_URL=http://localhost:8080
APP_TIMEZONE=America/Mexico_City
APP_LOCALE=es
APP_FALLBACK_LOCALE=en

LOG_CHANNEL=stderr
LOG_LEVEL=debug

# Usa una base local o una base de pruebas. No uses producción para migrar.
DB_CONNECTION=sqlsrv
DB_SQLSERVER_PDO_DRIVER=sqlsrv
DB_TDS_VERSION=7.4
# Reemplaza por el hostname de tu SQL Server de pruebas.
DB_HOST=sqlserver.example.test
DB_PORT=1433
DB_DATABASE=erpbms_pruebas
DB_USERNAME=usuario_pruebas
DB_PASSWORD=cambia-esta-credencial
DB_ENCRYPT=no
DB_TRUST_SERVER_CERTIFICATE=true

# Obligatorios al ejecutar PerfilAdminSeeder por primera vez.
ADMIN_EMAIL=
ADMIN_PASSWORD=

SESSION_DRIVER=file
SESSION_LIFETIME=120
CACHE_STORE=file
QUEUE_CONNECTION=sync
FILESYSTEM_DISK=local

MAIL_MAILER=log
MAIL_FROM_ADDRESS=local@erpbms.test
MAIL_FROM_NAME="ERP BMS Local"

VITE_APP_NAME="ERP BMS Local"
